;; riscv64 ISLE lowering rules

;; Integer arithmetic

(rule (lower (iadd ty x y))
      (rv_add ty x y))

(rule (lower (isub ty x y))
      (rv_sub ty x y))

(rule (lower (imul ty x y))
      (rv_mul ty x y))

(rule (lower (sdiv ty x y))
      (rv_div ty x y))

(rule (lower (udiv ty x y))
      (rv_divu ty x y))

(rule (lower (srem ty x y))
      (rv_rem ty x y))

(rule (lower (urem ty x y))
      (rv_remu ty x y))

;; Immediate forms

(rule (lower (iadd ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_addi ty x k))

;; Bitwise operations

(rule (lower (band ty x y))
      (rv_and ty x y))

(rule (lower (bor ty x y))
      (rv_or ty x y))

(rule (lower (bxor ty x y))
      (rv_xor ty x y))

(rule (lower (band ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_andi ty x k))

(rule (lower (bor ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_ori ty x k))

(rule (lower (bxor ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_xori ty x k))

;; Shift operations

(rule (lower (ishl ty x y))
      (rv_sll ty x y))

(rule (lower (ushr ty x y))
      (rv_srl ty x y))

(rule (lower (sshr ty x y))
      (rv_sra ty x y))

(rule (lower (ishl ty x (iconst k)))
      (if-let $true (uimm6 k))
      (rv_slli ty x k))

(rule (lower (ushr ty x (iconst k)))
      (if-let $true (uimm6 k))
      (rv_srli ty x k))

(rule (lower (sshr ty x (iconst k)))
      (if-let $true (uimm6 k))
      (rv_srai ty x k))

;; Comparison operations

(rule (lower (icmp IntCC.slt ty x y))
      (rv_slt ty x y))

(rule (lower (icmp IntCC.ult ty x y))
      (rv_sltu ty x y))

(rule (lower (icmp IntCC.slt ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_slti ty x k))

(rule (lower (icmp IntCC.ult ty x (iconst k)))
      (if-let $true (simm12 k))
      (rv_sltiu ty x k))

;; Load/store

(rule (lower (load ty addr _flags _offset))
      (rv_load ty addr))

(rule (lower (store val addr _flags _offset))
      (rv_store val addr))

;; Control flow

(rule (lower (jump target))
      (rv_jmp target))

(rule (lower (brif cond target))
      (rv_brif cond target))

(rule (lower (return))
      (rv_ret))

;; Constant materialization

(rule (lower (iconst ty k))
      (rv_iconst ty k))

;; Floating-point operations

(rule (lower (fadd ty x y))
      (rv_fadd ty x y))

(rule (lower (fsub ty x y))
      (rv_fsub ty x y))

(rule (lower (fmul ty x y))
      (rv_fmul ty x y))

(rule (lower (fdiv ty x y))
      (rv_fdiv ty x y))

(rule (lower (fsqrt ty x))
      (rv_fsqrt ty x))

(rule (lower (fmin ty x y))
      (rv_fmin ty x y))

(rule (lower (fmax ty x y))
      (rv_fmax ty x y))

;; FP comparisons

(rule (lower (fcmp FloatCC.eq ty x y))
      (rv_feq ty x y))

(rule (lower (fcmp FloatCC.lt ty x y))
      (rv_flt ty x y))

(rule (lower (fcmp FloatCC.le ty x y))
      (rv_fle ty x y))

;; FP conversions

(rule (lower (fcvt_from_sint ty x))
      (rv_fcvt_from_sint ty x))

(rule (lower (fcvt_from_uint ty x))
      (rv_fcvt_from_uint ty x))

(rule (lower (fcvt_to_sint ty x))
      (rv_fcvt_to_sint ty x))

(rule (lower (fcvt_to_uint ty x))
      (rv_fcvt_to_uint ty x))

(rule (lower (fdemote x))
      (rv_fcvt_s_d x))

(rule (lower (fpromote x))
      (rv_fcvt_d_s x))

;; FP load/store

(rule (lower (load $F32 addr _flags _offset))
      (rv_flw addr))

(rule (lower (load $F64 addr _flags _offset))
      (rv_fld addr))

(rule (lower (store (has_type $F32 val) addr _flags _offset))
      (rv_fsw val addr))

(rule (lower (store (has_type $F64 val) addr _flags _offset))
      (rv_fsd val addr))

;; Atomics

(rule (lower (atomic_rmw AtomicRmwOp.add ty addr val _ordering))
      (rv_amoadd ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.xchg ty addr val _ordering))
      (rv_amoswap ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.and ty addr val _ordering))
      (rv_amoand ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.or ty addr val _ordering))
      (rv_amoor ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.xor ty addr val _ordering))
      (rv_amoxor ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.min ty addr val _ordering))
      (rv_amomin ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.max ty addr val _ordering))
      (rv_amomax ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.umin ty addr val _ordering))
      (rv_amominu ty addr val))

(rule (lower (atomic_rmw AtomicRmwOp.umax ty addr val _ordering))
      (rv_amomaxu ty addr val))

(rule (lower (atomic_load ty addr _ordering))
      (rv_lr ty addr))

(rule (lower (atomic_store val addr _ordering))
      (rv_sc val addr))

;; Fence

(rule (lower (fence _ordering))
      (rv_fence))

;; Constructor terms for riscv64 instructions
(type Riscv64Inst (enum))

;; Lowering entry point
(decl lower (Value) Riscv64Inst)

;; Integer arithmetic
(decl rv_add (Type Value Value) Riscv64Inst)
(decl rv_sub (Type Value Value) Riscv64Inst)
(decl rv_mul (Type Value Value) Riscv64Inst)
(decl rv_div (Type Value Value) Riscv64Inst)
(decl rv_divu (Type Value Value) Riscv64Inst)
(decl rv_rem (Type Value Value) Riscv64Inst)
(decl rv_remu (Type Value Value) Riscv64Inst)

;; Integer arithmetic (immediates)
(decl rv_addi (Type Value i64) Riscv64Inst)

;; Bitwise ops
(decl rv_and (Type Value Value) Riscv64Inst)
(decl rv_or (Type Value Value) Riscv64Inst)
(decl rv_xor (Type Value Value) Riscv64Inst)
(decl rv_andi (Type Value i64) Riscv64Inst)
(decl rv_ori (Type Value i64) Riscv64Inst)
(decl rv_xori (Type Value i64) Riscv64Inst)

;; Shifts
(decl rv_sll (Type Value Value) Riscv64Inst)
(decl rv_srl (Type Value Value) Riscv64Inst)
(decl rv_sra (Type Value Value) Riscv64Inst)
(decl rv_slli (Type Value i64) Riscv64Inst)
(decl rv_srli (Type Value i64) Riscv64Inst)
(decl rv_srai (Type Value i64) Riscv64Inst)

;; Comparisons
(decl rv_slt (Type Value Value) Riscv64Inst)
(decl rv_sltu (Type Value Value) Riscv64Inst)
(decl rv_slti (Type Value i64) Riscv64Inst)
(decl rv_sltiu (Type Value i64) Riscv64Inst)

;; Load/store
(decl rv_load (Type Value) Riscv64Inst)
(decl rv_store (Value Value) Riscv64Inst)

;; Control flow
(decl rv_jmp (Block) Riscv64Inst)
(decl rv_brif (Value Block) Riscv64Inst)
(decl rv_ret () Riscv64Inst)

;; Constants
(decl rv_iconst (Type i64) Riscv64Inst)

;; Floating-point ops
(decl rv_fadd (Type Value Value) Riscv64Inst)
(decl rv_fsub (Type Value Value) Riscv64Inst)
(decl rv_fmul (Type Value Value) Riscv64Inst)
(decl rv_fdiv (Type Value Value) Riscv64Inst)
(decl rv_fsqrt (Type Value) Riscv64Inst)
(decl rv_fmin (Type Value Value) Riscv64Inst)
(decl rv_fmax (Type Value Value) Riscv64Inst)
(decl rv_feq (Type Value Value) Riscv64Inst)
(decl rv_flt (Type Value Value) Riscv64Inst)
(decl rv_fle (Type Value Value) Riscv64Inst)

;; Floating-point conversions
(decl rv_fcvt_from_sint (Type Value) Riscv64Inst)
(decl rv_fcvt_from_uint (Type Value) Riscv64Inst)
(decl rv_fcvt_to_sint (Type Value) Riscv64Inst)
(decl rv_fcvt_to_uint (Type Value) Riscv64Inst)
(decl rv_fcvt_s_d (Value) Riscv64Inst)
(decl rv_fcvt_d_s (Value) Riscv64Inst)

;; Floating-point load/store
(decl rv_flw (Value) Riscv64Inst)
(decl rv_fld (Value) Riscv64Inst)
(decl rv_fsw (Value Value) Riscv64Inst)
(decl rv_fsd (Value Value) Riscv64Inst)

;; Atomics
(decl rv_amoadd (Type Value Value) Riscv64Inst)
(decl rv_amoswap (Type Value Value) Riscv64Inst)
(decl rv_amoand (Type Value Value) Riscv64Inst)
(decl rv_amoor (Type Value Value) Riscv64Inst)
(decl rv_amoxor (Type Value Value) Riscv64Inst)
(decl rv_amomin (Type Value Value) Riscv64Inst)
(decl rv_amomax (Type Value Value) Riscv64Inst)
(decl rv_amominu (Type Value Value) Riscv64Inst)
(decl rv_amomaxu (Type Value Value) Riscv64Inst)
(decl rv_lr (Type Value) Riscv64Inst)
(decl rv_sc (Value Value) Riscv64Inst)

;; Fence
(decl rv_fence () Riscv64Inst)

;; ISLE IR prelude: shared types/enums for lowering/opts

;; Core IR primitives
(type Type (primitive Type))
(type Value (primitive Value))
(type Inst (primitive Inst))
(type Block (primitive Block))
(type StackSlot (primitive StackSlot))
(type GlobalValue (primitive GlobalValue))
(type JumpTable (primitive JumpTable))
(type SigRef (primitive SigRef))
(type ExternalName (primitive ExternalName))
(type RelocDistance (primitive RelocDistance))
(type ValueSlice (primitive ValueSlice))
(type Imm64 (primitive Imm64))
(type Ieee32 (primitive Ieee32))
(type Ieee64 (primitive Ieee64))
(type Offset32 (primitive Offset32))
(type MemFlags (primitive MemFlags))
(type TrapCode (primitive TrapCode))
(type Immediate (primitive u128))
(type SymbolValueData (primitive SymbolValueData))
(type FuncRefData (primitive FuncRefData))

;; Type/value helpers (used by lowering patterns)

(decl value_type (Type) Value)
(extern extractor value_type value_type_ext)

(decl has_type (Type Value) Value)
(extern extractor has_type has_type_ext)

;; Type predicates/extractors (used in `has_type`/`if` guards)

(decl ty_vec (Type) Type)
(extern extractor ty_vec ty_vec_ext)

(decl ty_vec64 (Type) Type)
(extern extractor ty_vec64 ty_vec64_ext)

(decl ty_vec_fits_in_register (Type) Type)
(extern extractor ty_vec_fits_in_register ty_vec_fits_in_register_ext)

(decl ty_32_or_64 (Type) Type)
(extern extractor ty_32_or_64 ty_32_or_64_ext)

(decl ty_float_or_vec (Type) Type)
(extern extractor ty_float_or_vec ty_float_or_vec_ext)

(decl ty_vector_float (Type) Type)
(extern extractor ty_vector_float ty_vector_float_ext)

(decl ty_vector_not_float (Type) Type)
(extern extractor ty_vector_not_float ty_vector_not_float_ext)

(decl ty_int_ref_scalar_64 (Type) Type)
(extern extractor ty_int_ref_scalar_64 ty_int_ref_scalar_64_ext)

(decl ty_int_ref_scalar_64_from_ty (Type) Type)
(extern extractor ty_int_ref_scalar_64_from_ty ty_int_ref_scalar_64_from_ty_ext)

(decl ty_equal (Type Type) bool)
(extern constructor ty_equal ty_equal_ctor)

;; Immediate conversions (used by constant materialization patterns)

(decl u64_from_imm64 (u64) Imm64)
(extern extractor u64_from_imm64 u64_from_imm64_ext)

(decl u64_from_i64 (u64) i64)
(extern extractor u64_from_i64 u64_from_i64_ext)

(decl pure u64_lt (u64 u64) bool)
(extern constructor u64_lt u64_lt)

(decl pure u64_lteq (u64 u64) bool)
(extern constructor u64_lteq u64_lteq)

(decl pure u64_nonzero (u64) bool)
(extern constructor u64_nonzero u64_nonzero)

(decl pure u64_to_u6 (u64) u6)
(extern constructor u64_to_u6 u64_to_u6)

(decl u32_from_ieee32 (u32) Ieee32)
(extern extractor u32_from_ieee32 u32_from_ieee32_ext)

(decl u64_from_ieee64 (u64) Ieee64)
(extern extractor u64_from_ieee64 u64_from_ieee64_ext)

;; Constant instructions

(decl iconst (Type i64) Value)
(extern constructor iconst iconst_ctor)
(extern extractor iconst iconst_ext)

(decl f32const (Ieee32) Value)
(extern constructor f32const f32const_ctor)
(extern extractor f32const f32const_ext)

(decl f64const (Ieee64) Value)
(extern constructor f64const f64const_ctor)
(extern extractor f64const f64const_ext)

;; Condition codes
(type IntCC (enum
  eq
  ne
  slt
  sge
  sgt
  sle
  ult
  uge
  ugt
  ule
))

(type FloatCC (enum
  ord
  uno
  eq
  ne
  one
  ueq
  lt
  le
  gt
  ge
  ult
  ule
  ugt
  uge
))

;; Atomics
(type AtomicOrdering (enum
  unordered
  monotonic
  acquire
  release
  acq_rel
  seq_cst
))

(type AtomicRmwOp (enum
  add
  sub
  and
  nand
  or
  xor
  xchg
  max
  min
  umax
  umin
))

;; Vector helper enums (used by SIMD lowering, esp. AArch64)

(type VecALUOp (enum
  Sqadd
  Uqadd
  Sqsub
  Uqsub
  Cmeq
  Cmge
  Cmgt
  Cmhs
  Cmhi
  Fcmeq
  Fcmgt
  Fcmge
  And
  Bic
  Orr
  Orn
  Eor
  Add
  Sub
  Mul
  Sshl
  Ushl
  Umin
  Smin
  Umax
  Smax
  Umaxp
  Urhadd
  Fadd
  Fsub
  Fdiv
  Fmax
  Fmin
  Fmul
  Addp
  Zip1
  Zip2
  Uzp1
  Uzp2
  Trn1
  Trn2
  Sqrdmulh
))

(type VecElemSize (enum
  Size8x8
  Size8x16
  Size16x4
  Size16x8
  Size32x2
  Size32x4
  Size64x2
))

(type VecMisc2 (enum
  Not
  Neg
  Abs
  Fabs
  Fneg
  Fsqrt
  Rev16
  Rev32
  Rev64
  Fcvtzs
  Fcvtzu
  Scvtf
  Ucvtf
  Frintn
  Frintz
  Frintm
  Frintp
  Cnt
  Cmeq0
  Cmge0
  Cmgt0
  Cmle0
  Cmlt0
  Fcmeq0
  Fcmge0
  Fcmgt0
  Fcmle0
  Fcmlt0
))


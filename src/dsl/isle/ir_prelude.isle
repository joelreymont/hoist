;; ISLE IR prelude: shared types/enums for lowering/opts

;; Core IR primitives
(type Type (primitive Type))
(type Value (primitive Value))
(type Inst (primitive Inst))
(type Block (primitive Block))
(type StackSlot (primitive StackSlot))
(type GlobalValue (primitive GlobalValue))
(type JumpTable (primitive JumpTable))
(type SigRef (primitive SigRef))
(type ExternalName (primitive ExternalName))
(type ValueSlice (primitive ValueSlice))
(type Offset32 (primitive Offset32))
(type MemFlags (primitive MemFlags))
(type TrapCode (primitive TrapCode))

;; Condition codes
(type IntCC (enum
  eq
  ne
  slt
  sge
  sgt
  sle
  ult
  uge
  ugt
  ule
))

(type FloatCC (enum
  ord
  uno
  eq
  ne
  one
  ueq
  lt
  le
  gt
  ge
  ult
  ule
  ugt
  uge
))

;; Atomics
(type AtomicOrdering (enum
  unordered
  monotonic
  acquire
  release
  acq_rel
  seq_cst
))

(type AtomicRmwOp (enum
  add
  sub
  and
  nand
  or
  xor
  xchg
  max
  min
  umax
  umin
))

;; Integer / bitwise operations

;; iadd/isub/imul: integer arithmetic
(decl iadd (Type Value Value) Value)
(extern constructor iadd iadd_ctor)
(extern extractor iadd iadd_ext)

(decl isub (Type Value Value) Value)
(extern constructor isub isub_ctor)
(extern extractor isub isub_ext)

(decl imul (Type Value Value) Value)
(extern constructor imul imul_ctor)
(extern extractor imul imul_ext)

;; band/bor/bxor/bnot: bitwise ops
(decl band (Type Value Value) Value)
(extern constructor band band_ctor)
(extern extractor band band_ext)

(decl bor (Type Value Value) Value)
(extern constructor bor bor_ctor)
(extern extractor bor bor_ext)

(decl bxor (Type Value Value) Value)
(extern constructor bxor bxor_ctor)
(extern extractor bxor bxor_ext)

(decl bnot (Type Value) Value)
(extern constructor bnot bnot_ctor)
(extern extractor bnot bnot_ext)

;; Shifts and rotates
(decl ishl (Type Value Value) Value)
(extern constructor ishl ishl_ctor)
(extern extractor ishl ishl_ext)

(decl ushr (Type Value Value) Value)
(extern constructor ushr ushr_ctor)
(extern extractor ushr ushr_ext)

(decl sshr (Type Value Value) Value)
(extern constructor sshr sshr_ctor)
(extern extractor sshr sshr_ext)

(decl rotl (Type Value Value) Value)
(extern constructor rotl rotl_ctor)
(extern extractor rotl rotl_ext)

(decl rotr (Type Value Value) Value)
(extern constructor rotr rotr_ctor)
(extern extractor rotr rotr_ext)

;; Floating-point operations

(decl fadd (Type Value Value) Value)
(extern constructor fadd fadd_ctor)
(extern extractor fadd fadd_ext)

(decl fsub (Type Value Value) Value)
(extern constructor fsub fsub_ctor)
(extern extractor fsub fsub_ext)

(decl fmul (Type Value Value) Value)
(extern constructor fmul fmul_ctor)
(extern extractor fmul fmul_ext)

(decl fdiv (Type Value Value) Value)
(extern constructor fdiv fdiv_ctor)
(extern extractor fdiv fdiv_ext)

(decl fmin (Type Value Value) Value)
(extern constructor fmin fmin_ctor)
(extern extractor fmin fmin_ext)

(decl fmax (Type Value Value) Value)
(extern constructor fmax fmax_ctor)
(extern extractor fmax fmax_ext)

(decl sqrt (Type Value) Value)
(extern constructor sqrt sqrt_ctor)
(extern extractor sqrt sqrt_ext)

(decl fsqrt (Type Value) Value)
(extern constructor fsqrt fsqrt_ctor)
(extern extractor fsqrt fsqrt_ext)

(decl fabs (Type Value) Value)
(extern constructor fabs fabs_ctor)
(extern extractor fabs fabs_ext)

(decl fneg (Type Value) Value)
(extern constructor fneg fneg_ctor)
(extern extractor fneg fneg_ext)

(decl fma (Type Value Value Value) Value)
(extern constructor fma fma_ctor)
(extern extractor fma fma_ext)

(decl fcopysign (Type Value Value) Value)
(extern constructor fcopysign fcopysign_ctor)
(extern extractor fcopysign fcopysign_ext)

(decl nearest (Type Value) Value)
(extern constructor nearest nearest_ctor)
(extern extractor nearest nearest_ext)

(decl trunc (Type Value) Value)
(extern constructor trunc trunc_ctor)
(extern extractor trunc trunc_ext)

(decl ceil (Type Value) Value)
(extern constructor ceil ceil_ctor)
(extern extractor ceil ceil_ext)

(decl floor (Type Value) Value)
(extern constructor floor floor_ctor)
(extern extractor floor floor_ext)
